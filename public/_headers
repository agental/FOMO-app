# The HTML entry must never be cached — the WebView (cacheEnabled in prod) would otherwise keep
# serving an old index.html that points at an old JS bundle, so web deploys never reach users.
# Always fetch it fresh; it then references the current content-hashed assets.
/
  Cache-Control: no-store, must-revalidate
/index.html
  Cache-Control: no-store, must-revalidate

# Content-hashed assets are immutable — cache them hard for fast image/JS/CSS loads.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
